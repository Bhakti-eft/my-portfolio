# Copy to .env.local and edit. All values are public (they end up in the built site).

# Absolute URL of the deployed site, no trailing slash. Used for canonical/OG tags.
VITE_SITE_URL=https://bhakti-eft.github.io/portfolio-web

# Base path. "/" for Vercel/Netlify/custom domain, "/<repo-name>/" for GitHub Pages.
# The GitHub Actions workflow sets this automatically.
VITE_BASE=/

# Formspree endpoint, e.g. https://formspree.io/f/abcdwxyz
# Leave empty and the contact form falls back to opening the visitor's mail app.
VITE_FORMSPREE_ENDPOINT=
